# ── Browser (public) ─────────────────────────────────────────────
# Supabase → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR-ANON-PUBLIC-KEY
# Your live address (used in emails and share previews)
NEXT_PUBLIC_SITE_URL=https://hcm.logixels.com

# ── Server only (never prefix with NEXT_PUBLIC_) ─────────────────
# Supabase → Project Settings → API → service_role. Needed for email codes and invitations.
SUPABASE_SERVICE_ROLE_KEY=

# Own email (OTP codes, invitations) through your Resend domain.
# The domain in MAIL_FROM must be verified in Resend.
RESEND_API_KEY=
MAIL_FROM=HCM Master Suite <no-reply@logixels.com>
# Any other SMTP instead of Resend: SMTP_HOST, SMTP_PORT (465/587), SMTP_USER, SMTP_PASS
# Optional: long random text used to hash email codes (defaults to the service role key)
# OTP_SECRET=

# AI copilot — free models. Groq first (console.groq.com), OpenRouter as backup (openrouter.ai)
GROQ_API_KEY=
OPENROUTER_API_KEY=
# Optional model lists (comma separated, tried in order)
# GROQ_MODELS=openai/gpt-oss-120b,llama-3.3-70b-versatile,openai/gpt-oss-20b
# OPENROUTER_MODELS=openrouter/free
